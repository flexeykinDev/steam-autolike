{
  "name": "steam-autolike",
  "version": "2.0.0",
  "private": true,
  "description": "Firefox extension: likes friends' posts in the Steam feed and leaves one emoticon comment per post.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --source-dir .",
    "build": "web-ext build --source-dir . --artifacts-dir dist --overwrite-dest --filename steam-autolike-{version}.xpi"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "web-ext": "^8.3.0"
  }
}
