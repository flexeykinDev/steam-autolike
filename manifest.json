{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "flexeykin",
  "homepage_url": "https://github.com/flexeykinDev/steam-autolike",
  "browser_specific_settings": {
    "gecko": {
      "id": "steam-autolike@flexeykin",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "*://steamcommunity.com/*",
    "*://*.steamstatic.com/*"
  ],
  "background": {
    "scripts": ["lib/core.js", "lib/strings.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://steamcommunity.com/*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-run": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_cmdToggle__"
    }
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/icon-16.svg", "32": "icons/icon-16.svg", "64": "icons/icon.svg" }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
